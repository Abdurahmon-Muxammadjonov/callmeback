interface ControlPage {
  pulse: {
    score: number | null;                                   // mean of the non-null indices, 0–100, integer
    indices: { key: 'activity' | 'conversion' | 'quality' | 'discipline'; value: number | null; note: Msg }[];
    summary: Msg | null;                                    // rule-based sentence
