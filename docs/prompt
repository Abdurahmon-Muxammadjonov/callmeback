### A.3.9 Reports: the permanent archive that replaces audio as the long-term record

Access: `owner`, `admin` and `rop` (the same roles as the Telegram report). Other roles get 403, and `/me.features.reports` is false for them.

```ts
type ReportType = 'daily' | 'weekly' | 'monthly' | 'custom';
type ReportKind = 'full' | 'calls' | 'operators';
type ReportFormat = 'pdf' | 'xlsx' | 'csv';

GET  /reports?type=all|daily|weekly|monthly|custom&from=&to=&cursor=&limit=
     → { items: StoredReport[]; nextCursor: string | null; total: number;
         counts: Record<'all' | ReportType, number>; today: ReportSummary | null }
     // newest period first. Automatic reports exist for EVERY past day, week and month since the company's first call.
     // `today` is a live summary of today, shown in the reports center's pinned row.
GET  /reports/{id} → StoredReport & { data: ReportData | null }      // data null until status = done
POST /reports { kind: ReportKind; from: ISODate; to: ISODate; formats: ReportFormat[]; locale: 'uz' | 'ru'; filters?: CallsFilter }
     → 202 { id: string }         // creates a 'custom' report; csv only for kind 'calls'; filters only for kind 'calls'
     → 422 { code: 'too_many_rows' } when a calls export exceeds 200 000 rows
POST /reports/{id}/download { format: ReportFormat }
     → 200 { url: string; expiresAt: ISODateTime }                     // signed, 15 min
     → 202 { status: 'generating' }                                    // the file is being built; wait for report.updated
                                                                       // (or poll GET /reports/{id} every 2 s), then call again
POST /reports/bundle { ids: string[]; format: 'pdf' | 'xlsx' } → 202 { id: string }      // ZIP, max 400 reports
GET  /reports/bundle/{id} → { status: 'queued' | 'running' | 'done' | 'failed'; progress: number; sizeBytes: number | null; error: string | null }
POST /reports/bundle/{id}/download → { url: string; expiresAt: ISODateTime }
DELETE /reports/{id} → 204                                             // only type 'custom', by its creator or owner/admin

interface StoredReport {
  id: string; type: ReportType; kind: ReportKind; from: ISODate; to: ISODate; locale: 'uz' | 'ru';
  final: boolean;              // false = preliminary (daily report at the evening report time); true after the day/week/month is closed
  status: 'queued' | 'running' | 'done' | 'failed'; progress: number;
  createdAt: ISODateTime; updatedAt: ISODateTime; createdBy: { id: string; name: string } | null;   // null = automatic
  summary: ReportSummary | null;
  files: { format: ReportFormat; sizeBytes: number }[];                // formats already built
  error: string | null;
}
interface ReportSummary {
  calls: number; talkSec: number; rated: number; avgScore10: Score10 | null;
  leads: number | null; offers: number | null; deals: number | null; conversionPct: number | null;
  uncontactedLeads: number | null; laggingOperators: number;
}
interface ReportData {
  period: { type: ReportType; from: ISODate; to: ISODate; until: ISODateTime | null };
  generatedAt: ISODateTime;
  totals: ReportSummary & { inbound: number; outbound: number; longCalls: number; notAnalyzed: number;
                            bonusSum: number; penaltySum: number };
  reasons: { key: ReasonKey; count: number }[];
  operators: { op: OperatorRef; calls: number; longCalls: number; normTarget: number; talkSec: number; rated: number;
               score10: Score10 | null; bonusSum: number; penaltySum: number; topError: string | null }[];
  weakest: { op: OperatorRef; score10: Score10 | null; issues: string[] } | null;   // "shu xodimda oqsoqlik kuzatildi"
  best: { op: OperatorRef; score10: Score10 } | null;
  criteria: { label: string; pct: number }[];                                       // team average per criterion
  byDay: { day: ISODate; calls: number; rated: number; avgScore10: Score10 | null }[];   // weekly, monthly, custom
  text: string;                     // plain-text version, identical to the Telegram report (may contain emoji)
}
```

## A.4 Live events (Server-Sent Events)

```
POST /events/token → { token: string; expiresAt: ISODateTime }    // 60 min, bound to user + company
GET  /events?token=…  (text/event-stream, heartbeat comment every 25 s)

event: call.created          data: { id, startedAt, opExt | null, direction, status }
event: call.updated          data: { id, status, reason | null, score10 | null, audioState, keep, expiresAt | null }
event: stats.changed         data: { scope: 'today' | 'past', days: ISODate[] }      // at most once per 5 s per company
event: notification.created  data: NotificationItem
event: report.updated        data: { id, status, progress, files }
event: bundle.updated        data: { id, status, progress }
event: stt.health            data: { paused: boolean }
event: badges                data: { audioLowToday, notificationsUnread }
```

**Client rules**
- Reconnect with exponential backoff (1 s → 30 s) and refresh the token before it expires.
- After a company switch, fetch a new token and reconnect.
- After 3 failed reconnects, fall back to polling:
  - `/badges` every 30 s;
  - active queries every 60 s;
  - pending report and bundle jobs every 2 s.

