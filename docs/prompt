}
GET  /calls/{id}/transcript → { segments: { speaker: 'operator' | 'client' | null; start: number | null; end: number | null; text: string }[] }
POST /calls/{id}/audio-url  → { url: string; expiresAt: ISODateTime }
     // signed, ≤ 15 min, supports HTTP Range; 410 { code: 'audio_expired' }; 404 { code: 'audio_missing' }
PUT  /calls/{id}/keep { keep: boolean } → { keep: boolean; audio: { state: AudioState; expiresAt: ISODateTime | null } }
     // owner/admin/rop. keep=true on a call still in the 7-day trash restores the audio first.
